# SiagaBanjir - Konfigurasi Lingkungan Flutter (Client)
# Salin file ini menjadi .env:
#   cp .env.example .env (Linux/macOS) atau Copy-Item .env.example .env (PowerShell)
#
# Jalankan Flutter dengan parameter pembacaan env:
#   flutter run --dart-define-from-file=.env

# URL Base API Backend (Fastify):
# - Untuk tunnel remote publik: https://api.rafitesting.cloud
# - Untuk testing lokal via ADB reverse / Chrome / Desktop: http://127.0.0.1:3000
# - Untuk testing Android Emulator: http://10.0.2.2:3000
API_BASE_URL=https://api.rafitesting.cloud
