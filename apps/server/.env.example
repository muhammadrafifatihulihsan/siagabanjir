# Konfigurasi lokal. Jangan commit nilai rahasia.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Dibaca oleh db:check dan entry server untuk signup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siagabanjirdev
DB_USER=sb_dev_app
DB_PASSWORD=

# Key hex 32 byte berbeda per tujuan; wajib untuk entry server.
RECOVERY_HMAC_KEY=
JOURNAL_HMAC_KEY=
CURSOR_HMAC_KEY=

# Khusus worker, tidak dikirim ke Flutter. DEEPSEEKAPI lama juga diterima.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Binary lokal: executable tersedia pada PATH atau isi path absolut.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PDFINFO_PATH=pdfinfo
PDFTOPPM_PATH=pdftoppm
