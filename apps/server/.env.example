# Fondasi lokal. Tidak berisi kredensial atau konfigurasi provider.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Dibaca hanya oleh db:check; HTTP metadata belum memakai DB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siagabanjirdev
DB_USER=sb_dev_app
DB_PASSWORD=

# Key hex 32 byte berbeda per tujuan; dihubungkan saat implementasi auth.
RECOVERY_HMAC_KEY=
JOURNAL_HMAC_KEY=
CURSOR_HMAC_KEY=
