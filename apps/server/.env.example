# ==============================================================
# SiagaBanjir Server Environment Template
# Salin berkas ini ke `.env` untuk runtime server & migrasi dev.
# ==============================================================

# 1. Konfigurasi Lingkungan Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 2. Basis Data Runtime (DML - Digunakan oleh server & signup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siagabanjirdev
DB_USER=sb_dev_app
DB_PASSWORD=sb_dev_app

# 3. Basis Data Migrasi Skema (DDL - Digunakan oleh db:migrate)
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_USER=sb_dev_migrate
MIGRATION_DB_PASSWORD=sb_dev_migrate

# 4. Kunci Kriptografi Keamanan (Wajib 64 Karakter Hex Unik Berbeda)
RECOVERY_HMAC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JOURNAL_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
CURSOR_HMAC_KEY=456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123

# 5. Layanan Worker AI (Opsional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 6. Penyimpanan Media (Opsional)
# Default: <cwd server>/storage. Struktur otomatis:
#   storage/uploads/REPORT/<tahun>/<bulan>/<uploadId>_<sha256>
#   storage/uploads/DOCUMENT/<tahun>/<bulan>/<uploadId>_<sha256>
#   storage/working/  (sementara AI, dibersihkan otomatis)
# Di Docker nilainya /app/storage dengan volume media_data.
STORAGE_DIR=
