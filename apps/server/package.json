{
  "name": "@siagabanjir/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "db:check": "node --env-file=.env --import tsx src/db/cli.ts check",
    "db:migrate": "node --env-file=.env.migrate --import tsx src/db/cli.ts migrate",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "test:db": "node --env-file=.env.test --import tsx --test test/database.integration.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
