root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Ukuran indentasi daftar Markdown bervariasi; struktur diperiksa markdownlint.
indent_size = unset
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[apps/siagabanjir/android/**.xml]
# Komentar template Flutter memakai alignment, bukan kelipatan indentasi.
# Encoding, EOL, final newline, indent_style dan trailing whitespace tetap dicek.
indent_size = unset

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

# Arsip dipertahankan sebagai bukti; jangan memformat ulang saat membuka.
[archive/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
